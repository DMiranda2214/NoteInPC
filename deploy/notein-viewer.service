[Unit]
Description=Visor local de cuadernos NoteIn
After=network.target

[Service]
Type=simple
WorkingDirectory=@REPO@/visor
ExecStart=/usr/bin/python3 -I @REPO@/visor/server.py
EnvironmentFile=-%h/.config/notein-viewer/env
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
